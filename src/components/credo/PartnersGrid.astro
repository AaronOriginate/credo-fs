---
/** PartnersGrid — exact copy of S05PartnersGrid with Credo brands */
import { href } from '../../lib/nav';
import BtnText from './BtnText.astro';
interface Props {
  heading?: string;
  subtext?: string;
}
const {
  heading = "I don't sell one brand. I find the right one.",
  subtext = "I work with eight providers, Square, Teya, Sunmi, Elavon, Shift4, Loyverse, Kuulseats, and Liberis, because different businesses need different things. When I review your setup, I'm not trying to push you toward one product. I'm looking for what actually fits. The right answer for a 40-cover restaurant in Bristol isn't necessarily the right answer for a late-night bar in London. I know the difference. And I'll tell you straight.",
} = Astro.props;
---

<!-- Section 05 — Partners Grid | Figma: fileKey=RxueMLDFnpgheWZp4MVk7f nodeId=8:146 -->
<section data-figma-ref="8:146" class="bg-white pt-32 pb-20 sm:pt-40 sm:pb-28 lg:pt-48 lg:pb-32">
  <div class="max-w-[1232px] mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section label -->
    <p class="text-xs uppercase tracking-widest text-dark mb-4">Partners I Trust</p>
    <div class="w-12 h-0.5 bg-accent mb-12 sm:mb-16"></div>

    <!-- 2-col heading -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-24 mb-12 sm:mb-16">
      <h2 data-reveal class="font-heading font-medium text-dark text-3xl sm:text-4xl lg:text-5xl leading-tight">
        {heading}
      </h2>
      <p data-reveal="fade" style="--reveal-delay: 200ms;" class="text-gray-text leading-relaxed self-end">
        {subtext}
      </p>
    </div>

    <!-- 2-col content: device image + brand tiles -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-24">
      <!-- Left: device image -->
      <div data-reveal="fade">
        <div class="w-full aspect-[4/3] bg-navy rounded-lg overflow-hidden flex items-center justify-center p-8">
          <img
            src={`${import.meta.env.BASE_URL}/images/credo/partners-device.webp`}
            alt="Tablet device"
            width="1024"
            height="1024"
            loading="lazy"
            class="max-w-full max-h-full object-contain"
          />
        </div>
      </div>

      <!-- Right: brand tiles grid + link -->
      <div class="flex flex-col justify-center">
        <div class="grid grid-cols-2 gap-3 mb-8" data-reveal-group="tight">
          {[
            "Square", "Teya", "Sunmi", "Elavon",
            "Shift4", "Loyverse", "Kuulseats", "Liberis"
          ].map((brand) => (
            <div data-reveal class="bg-light-gray rounded-lg py-3 px-4 text-center text-sm font-medium text-dark">
              {brand}
            </div>
          ))}
        </div>
        <BtnText href="/systems-and-solutions" class="text-sm font-semibold text-dark hover:text-accent transition-colors">See all partners</BtnText>
      </div>
    </div>
  </div>
</section>
