---
/** NarrativeBlock — Figma node 4:38 */
import { href } from '../../lib/nav';
import Btn from './Btn.astro';
---

<section class="w-full">
  <div class="max-w-[1232px] mx-auto px-8 pt-32 pb-20 sm:pt-40 sm:pb-28 lg:pt-48 lg:pb-32">
    <!-- Top section: two-column layout -->
    <div class="flex flex-row gap-16 lg:gap-24 items-start">
      <!-- Left column: image placeholder (~45%) -->
      <div class="w-[45%] shrink-0" data-reveal="fade">
        <div class="bg-navy rounded-lg overflow-hidden aspect-[4/5]">
          <img src={`${import.meta.env.BASE_URL}/images/credo/narrative-person.webp`} alt="Andy Sherborne" width="600" height="668" loading="lazy" class="w-full h-full object-cover" />
        </div>
      </div>

      <!-- Right column: copy + CTA + logos (~55%) -->
      <div class="flex-1 flex flex-col" data-reveal-group>
        <!-- Section heading -->
        <h2 data-reveal class="font-heading font-medium text-dark leading-[1.1] tracking-[-0.02em] mb-6" style="font-size: clamp(1.875rem, 4vw, 3.25rem);">
          Sound familiar?
        </h2>
        <!-- Body text -->
        <p data-reveal class="text-[22px] leading-[38.5px] text-dark">
          A card machine rep walks into your pub. First thing you ask: <em>"Does it integrate with my EPOS system?"</em>
        </p>
        <p data-reveal class="text-base leading-relaxed text-gray-text mt-4">
          And that's exactly the problem.
        </p>
        <p data-reveal class="text-base leading-relaxed text-gray-text mt-4">
          You're not asking because you love your current till. You're asking because your entire business lives on it. Your menu, your staff, your sales data, your end-of-day. Switching feels like a risk you can't afford to take. So you switch the card machine, save a few quid a month, and sign an 18-month contract.
        </p>
        <p data-reveal class="text-base leading-relaxed text-gray-text mt-4">
          Six weeks later, the wifi drops. The till and the card machine stop talking to each other. You call the EPOS company. They tell you to call the card machine company. The card machine company tells you to call the EPOS company. It's Saturday night. Nobody's fixing anything.
        </p>
        <p data-reveal class="text-base leading-relaxed text-gray-text mt-4">
          This is the reality for around 70% of pubs and restaurants in the UK. Two separate systems, two separate providers, and you caught in the middle.
        </p>
        <p data-reveal class="text-base leading-relaxed text-gray-text mt-4">
          I built Credo FS to change that.
        </p>

        <!-- Yellow CTA button -->
        <div data-reveal class="mt-6 w-fit">
          <Btn href="/contact" variant="primary">Arrange a call with Andy</Btn>
        </div>

        <!-- Trust bar -->
        <div class="mt-12">
          <div class="flex items-center gap-3">
            <div class="flex items-center gap-0.5">
              <svg class="h-5 w-5 text-accent" viewBox="0 0 20 20" fill="currentColor"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
              <svg class="h-5 w-5 text-accent" viewBox="0 0 20 20" fill="currentColor"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
              <svg class="h-5 w-5 text-accent" viewBox="0 0 20 20" fill="currentColor"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
              <svg class="h-5 w-5 text-accent" viewBox="0 0 20 20" fill="currentColor"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
              <svg class="h-5 w-5 text-accent" viewBox="0 0 20 20" fill="currentColor"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
            </div>
            <p class="text-base text-dark">
              5.0 on TrustPilot, 6 reviews, all five stars
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
