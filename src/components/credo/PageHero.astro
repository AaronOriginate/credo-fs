---
/** PageHero — S02Hero for home (large/centered) + S12/S05 pattern for sub-pages (left-aligned) */
interface Props {
  heading: string;
  subtext?: string;
  eyebrow?: string;
  body?: string[];
  size?: 'large' | 'default';
  bgImage?: string;
}
const {
  heading,
  subtext,
  eyebrow,
  body,
  size = 'default',
  bgImage,
} = Astro.props;

const isLarge = size === 'large';
const bgUrl = bgImage ? `${import.meta.env.BASE_URL}/images/credo/hero-bg-${bgImage}.webp` : null;
---

<!-- Section 02 — Hero | Figma: fileKey=RxueMLDFnpgheWZp4MVk7f nodeId=8:24 -->
<section data-figma-ref="8:24" class={`relative overflow-hidden py-12 sm:py-20 lg:py-28 ${isLarge ? 'bg-white' : 'bg-navy'}`}>
  {bgUrl && (
    <>
      <div
        class="absolute inset-0 bg-cover bg-center pointer-events-none z-0"
        style={`background-image: url('${bgUrl}'); mask-image: linear-gradient(to right, transparent 0%, transparent 50%, black 90%); -webkit-mask-image: linear-gradient(to right, transparent 0%, transparent 50%, black 90%);`}
        aria-hidden="true"
      ></div>
      <div class="absolute inset-0 bg-navy/65 pointer-events-none z-0" aria-hidden="true"></div>
    </>
  )}

  <!-- Chunky credo graphic, clipping off top-left (white+lime variant on navy sub-page hero, navy+lime on home). Hidden on mobile to avoid overlapping headline. -->
  <div class="hidden lg:block absolute overflow-hidden pointer-events-none z-20 -top-40 xl:-top-8" style="width: clamp(140px, 18vw, 360px); aspect-ratio: 626 / 744; left: clamp(-3rem, -2vw, 0rem);">
    <img
      src={`${import.meta.env.BASE_URL}/images/credo/${isLarge ? 'hero-credo4.png' : 'hero-credo4-white.png'}`}
      alt=""
      width="626"
      height="744"
      class="w-full h-auto"
      aria-hidden="true"
    />
  </div>

  <div class={`max-w-[1232px] mx-auto px-6 sm:px-8 relative z-10 ${isLarge ? '' : 'md:pt-[clamp(4rem,8vw,7rem)]'}`}>
    {isLarge ? (
      <!-- Home page: centered, massive -->
      <Fragment>
        {eyebrow && (
          <p class="text-xs uppercase tracking-widest text-dark text-center mb-6">{eyebrow}</p>
        )}
        <h1 class="font-heading font-medium text-dark text-center leading-[1.1] tracking-[-0.02em] max-w-5xl mx-auto" style="font-size: clamp(1.75rem, 3.5vw, 3.5rem);">
          {heading}
        </h1>
        {subtext && (
          <p class="text-dark text-center text-base sm:text-lg max-w-xl mx-auto mt-6">
            {subtext}
          </p>
        )}
      </Fragment>
    ) : (
      <!-- Sub-pages: left-aligned, smaller, 2-col with body text, navy bg -->
      <Fragment>
        {eyebrow && (
          <p class="text-xs uppercase tracking-widest text-accent mb-6">{eyebrow}</p>
        )}
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-24">
          <h1 class="font-heading font-medium text-white leading-[1.1] tracking-[-0.02em]" style="font-size: clamp(1.5rem, 3.5vw, 2.75rem);">
            {heading}
          </h1>
          {(body || subtext) && (
            <div class="flex flex-col justify-end">
              {body ? (
                body.map((p, i) => (
                  <p class={`text-white/70 leading-relaxed ${i < body.length - 1 ? 'mb-4' : ''}`}>
                    {p}
                  </p>
                ))
              ) : subtext ? (
                <p class="text-white/70 leading-relaxed">
                  {subtext}
                </p>
              ) : null}
            </div>
          )}
        </div>
      </Fragment>
    )}
  </div>
</section>
