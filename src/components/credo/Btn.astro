---
/** Btn — primary/secondary CTA with arrow + text-flip hover animation.
 *  Matches WP credofsdev pattern: leading arrow, swap colours on hover, text rotates up
 *  while a duplicate slides in from below.
 *
 *  Variants:
 *    primary   — bg-accent / text-dark   → bg-navy / text-white on hover
 *    secondary — bg-navy / text-white    → bg-white / text-navy on hover (border)
 *    ghost     — transparent / text-accent → transparent / text-accent (arrow only animates)
 */
import { href as navHref } from '../../lib/nav';

interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'sm' | 'md';
  arrow?: boolean;
  class?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  arrow = true,
  class: extraClass = '',
} = Astro.props;

const slot = await Astro.slots.render('default');

const resolvedHref = href.startsWith('#') || href.startsWith('http') ? href : navHref(href);

const sizeClass = size === 'sm' ? 'px-5 py-2.5 text-sm' : 'px-7 py-3.5 text-base';

const variantClass =
  variant === 'primary'
    ? 'btn-primary'
    : variant === 'secondary'
      ? 'btn-secondary'
      : 'btn-ghost';
---

<a
  href={resolvedHref}
  class={`btn-flip ${variantClass} ${sizeClass} ${extraClass} font-heading font-semibold rounded-lg inline-flex items-center justify-center gap-2 leading-none whitespace-nowrap`}
>
  {arrow && (
    <span class="btn-arrow inline-flex items-center" aria-hidden="true">
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 12h14M13 5l7 7-7 7"/>
      </svg>
    </span>
  )}
  <span class="btn-text-wrap relative inline-block overflow-hidden">
    <span class="btn-text-a block" set:html={slot} />
    <span class="btn-text-b absolute inset-0 block" set:html={slot} />
  </span>
</a>
