---
/** NavyStatement — Figma node 4:33 */
import { href } from '../../lib/nav';
import BtnText from './BtnText.astro';
interface Props {
  heading?: string;
  body?: string;
  stats?: { value: string; label: string }[];
  linkText?: string;
  linkHref?: string;
  bg?: 'navy' | 'accent';
  image?: string;
}
const {
  heading = "Forty years on your side",
  body = "I'm not a card machine rep. I'm not a till salesman. I'm a hospitality operator who spent 20 years with Whitbread plc, ran my own pubs and restaurants, and got tired of watching good operators get a raw deal from people who didn't understand, or care about, how a pub actually works. I started Credo FS because the technology exists to make all of this simple. The problem was never the tech. It was the people selling it.",
  stats = [
    { value: "30+", label: "years in hospitality" },
    { value: "100%", label: "independent" },
    { value: "1", label: "point of contact" },
  ],
  linkText = "Read more about my background",
  linkHref = "/about",
  bg = 'navy',
  image = `${import.meta.env.BASE_URL}/images/credo/navy-statement-bg.webp`,
} = Astro.props;

const isAccent = bg === 'accent';
const showImage = !isAccent && image;
---

<section class={`${isAccent ? 'bg-accent' : 'bg-navy'} w-full relative overflow-hidden`}>
  {showImage && (
    <>
      <div
        class="absolute inset-0 bg-cover bg-center pointer-events-none"
        style={`background-image: url('${image}'); mask-image: linear-gradient(to right, transparent 0%, transparent 50%, black 90%); -webkit-mask-image: linear-gradient(to right, transparent 0%, transparent 50%, black 90%);`}
        aria-hidden="true"
      ></div>
      <div class="absolute inset-0 bg-navy/60 pointer-events-none" aria-hidden="true"></div>
    </>
  )}
  <div class="max-w-[1232px] mx-auto px-6 sm:px-8 pt-28 pb-28 sm:pt-32 sm:pb-32 lg:pt-32 lg:pb-32 relative z-10">
    <h2 data-reveal class={`font-heading font-medium leading-[1.05] tracking-[-0.025em] max-w-[990px] ${isAccent ? 'text-dark' : 'text-white'}`} style="font-size: clamp(2.25rem, 6vw, 5rem);">
      {heading}
    </h2>

    <p data-reveal="fade" style="--reveal-delay: 200ms;" class={`text-lg leading-relaxed max-w-[700px] mt-8 ${isAccent ? 'text-dark/70' : 'text-white/80'}`}>
      {body}
    </p>

    {(stats.length > 0 || linkHref) && (
      <div class="flex flex-wrap items-center gap-6 mt-10" data-reveal-group="wide">
        {stats.map((stat) => (
          <div data-reveal class={`border rounded-lg px-6 py-4 text-center ${isAccent ? 'border-dark/20' : 'border-white/20'}`}>
            <p class={`font-heading font-medium text-3xl ${isAccent ? 'text-dark' : 'text-accent'}`}>{stat.value}</p>
            <p class={`text-sm mt-1 ${isAccent ? 'text-dark/60' : 'text-white/60'}`}>{stat.label}</p>
          </div>
        ))}
        {linkHref && (
          <BtnText href={linkHref} class={`font-medium ml-auto ${isAccent ? 'text-dark' : 'text-accent'}`}>{linkText}</BtnText>
        )}
      </div>
    )}
  </div>
</section>
