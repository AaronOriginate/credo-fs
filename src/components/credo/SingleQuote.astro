---
/** SingleQuote — Figma node 4:432 */
import { href } from '../../lib/nav';
import BtnText from './BtnText.astro';
interface Props {
  label?: string;
  heading?: string;
  quote?: string;
  name?: string;
  source?: string;
  linkText?: string;
  linkHref?: string;
  image?: string;
}
const {
  label = "What clients say",
  heading = "5.0 on TrustPilot. 6 reviews. Every one five stars.",
  quote = "The best experience since starting my business in 2016. I always recommend Andy to fellow traders.",
  name = "Ron De La Cruz",
  source = "TrustPilot",
  linkText = "Read all the reviews",
  linkHref = "/reviews",
  image = `${import.meta.env.BASE_URL}/images/credo/hospitality-scene.webp`,
} = Astro.props;
---

<section class="w-full">
  <div class="max-w-[1232px] mx-auto px-6 sm:px-8 py-16">
    <p class="uppercase text-sm font-medium tracking-[2px] text-dark">{label}</p>
    <div class="w-12 h-0.5 bg-accent mt-4"></div>

    <div data-reveal class="relative bg-navy rounded-lg mt-12 px-8 sm:px-16 py-16 sm:py-20 overflow-hidden">
      {image && (
        <>
          <div
            class="absolute inset-0 bg-cover bg-center pointer-events-none"
            style={`background-image: url('${image}'); mask-image: linear-gradient(to right, transparent 0%, transparent 50%, black 90%); -webkit-mask-image: linear-gradient(to right, transparent 0%, transparent 50%, black 90%);`}
            aria-hidden="true"
          ></div>
          <div class="absolute inset-0 bg-navy/65 pointer-events-none" aria-hidden="true"></div>
        </>
      )}
      <div class="relative z-10 flex flex-col items-center text-center">
        <div class="flex items-center gap-1 mb-6" data-reveal-group="tight">
          {[1,2,3,4,5].map(() => (
            <svg data-reveal class="h-5 w-5 text-accent" viewBox="0 0 20 20" fill="currentColor"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
          ))}
        </div>
        <p data-reveal="fade" style="--reveal-delay: 400ms;" class="font-heading font-medium text-2xl sm:text-3xl leading-snug tracking-tight text-white max-w-3xl">&ldquo;{quote}&rdquo;</p>
        <div class="mt-8">
          <p data-reveal="fade" style="--reveal-delay: 600ms;" class="text-lg leading-relaxed text-white/80">
            <span class="font-semibold text-white">{name}</span>, {source}
          </p>
        </div>
        {linkHref && (
          <div class="mt-6">
            <BtnText href={linkHref} class="text-sm font-semibold text-accent hover:text-white transition-colors">{linkText}</BtnText>
          </div>
        )}
      </div>
    </div>
  </div>
</section>
