---
import Btn from './Btn.astro';
---
<!-- Figma node: 4:851 — PersonalSection -->
<section class="w-full">
  <div class="max-w-[1232px] mx-auto px-6 sm:px-8 py-16">
    <div data-reveal class="bg-navy rounded-lg p-8">
      <!-- Top: heading + CTA -->
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
          <h2 class="font-heading font-medium text-[32px] leading-[40px] tracking-[-0.8px] text-white">
            About Andy
          </h2>
          <p class="text-[22px] leading-relaxed text-white mt-1">
            The person behind Credo
          </p>
        </div>
        <div class="shrink-0"><Btn href="#contact" variant="primary">Get in Touch</Btn></div>
      </div>

      <!-- Divider -->
      <div class="border-t border-white/10 mt-6"></div>

      <!-- Feature items: 2-col grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-4 mt-6" data-reveal-group="tight">
        <div data-reveal class="flex items-center gap-3">
          <svg class="size-5 text-accent shrink-0" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
          </svg>
          <p class="text-lg text-white">Rugby referee for 20 years</p>
        </div>
        <div data-reveal class="flex items-center gap-3">
          <svg class="size-5 text-accent shrink-0" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
          </svg>
          <p class="text-lg text-white">Refereed in 12 countries</p>
        </div>
        <div data-reveal class="flex items-center gap-3">
          <svg class="size-5 text-accent shrink-0" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
          </svg>
          <p class="text-lg text-white">Bristol Referees Society member</p>
        </div>
        <div data-reveal class="flex items-center gap-3">
          <svg class="size-5 text-accent shrink-0" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
          </svg>
          <p class="text-lg text-white">20 years in food service systems</p>
        </div>
      </div>
    </div>
  </div>
</section>
