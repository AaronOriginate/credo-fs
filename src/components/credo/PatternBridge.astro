---
/** PatternBridge — exact copy of S19CtaBandGray with props */
import Btn from './Btn.astro';
interface Props {
  heading: string;
  linkText?: string;
  linkHref?: string;
}
const { heading, linkText, linkHref } = Astro.props;
---

<!-- Section 19 — CTA Band Gray | Figma: fileKey=RxueMLDFnpgheWZp4MVk7f nodeId=4:764 -->
<section data-figma-ref="4:764" class="bg-accent pt-28 pb-12 sm:pt-32 sm:pb-20 lg:pt-32 lg:pb-28">
  <div class="max-w-[1232px] mx-auto px-6 sm:px-8">
    <h2 data-reveal class="font-heading font-medium text-dark text-center text-3xl sm:text-5xl lg:text-[56px] lg:leading-[1.25] tracking-tight max-w-[990px] mx-auto">
      {heading}
    </h2>
    {linkText && linkHref && (
      <div data-reveal="fade" style="--reveal-delay: 200ms;" class="flex justify-center mt-10">
        <Btn href={linkHref} variant="secondary">{linkText}</Btn>
      </div>
    )}
  </div>
</section>
