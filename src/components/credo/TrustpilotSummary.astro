---
import { href } from '../../lib/nav';
import Btn from './Btn.astro';
---
<!-- Figma node: 4:770 — TrustpilotSummary -->
<section class="bg-white w-full">
  <div class="max-w-[1232px] mx-auto px-6 sm:px-8 pt-28 pb-12 sm:pt-32 sm:pb-20 lg:pt-32 lg:pb-28">
    <!-- Section label + yellow divider -->
    <p class="uppercase text-sm font-medium tracking-[2px] text-dark">
      Trustpilot
    </p>
    <div class="w-12 h-0.5 bg-accent mt-4"></div>

    <!-- Trustpilot table -->
    <div class="flex flex-col lg:flex-row border border-[#ccced3] rounded-lg overflow-hidden mt-12" data-reveal-group="cards">
      <!-- Left panel — large heading -->
      <div data-reveal class="lg:w-[35%] p-6 sm:p-7 flex items-start">
        <h2 class="font-heading font-medium leading-tight text-dark tracking-[-1.4px]" style="font-size: clamp(1.875rem, 5vw, 3.5rem);">
          5.0 out of 5 on TrustPilot
        </h2>
      </div>

      <!-- Column: 6 Reviews -->
      <div data-reveal class="flex-1 border-t lg:border-t-0 lg:border-l border-[#ccced3] p-7 flex flex-col">
        <h3 class="font-heading font-medium text-2xl text-dark tracking-[-0.6px]">
          6 Reviews
        </h3>
        <p class="text-lg leading-relaxed text-dark mt-2">
          Every review is five stars, left by business owners I've actually worked with.
        </p>
        <div class="flex items-end gap-2 mt-auto pt-6">
          <span class="font-heading font-medium leading-[1.1] text-dark tracking-[-1.4px]" style="font-size: clamp(2.5rem, 7vw, 3.5rem);">5.0</span>
          <span class="text-sm text-dark mb-3">/ 5 stars</span>
        </div>
        <div class="mt-4"><Btn href="/reviews" variant="primary" size="sm">Read Reviews</Btn></div>
      </div>

      <!-- Column: Verified -->
      <div data-reveal class="flex-1 border-t lg:border-t-0 lg:border-l border-[#ccced3] p-7 flex flex-col">
        <h3 class="font-heading font-medium text-2xl text-dark tracking-[-0.6px]">
          Verified
        </h3>
        <p class="text-lg leading-relaxed text-dark mt-2">
          All reviews posted independently on TrustPilot by real customers.
        </p>
        <div class="flex items-end gap-2 mt-auto pt-6">
          <span class="font-heading font-medium leading-[1.1] text-dark tracking-[-1.4px]" style="font-size: clamp(2.5rem, 7vw, 3.5rem);">100</span>
          <span class="text-sm text-dark mb-3">% real</span>
        </div>
        <div class="mt-4"><Btn href="/reviews" variant="primary" size="sm">View Profile</Btn></div>
      </div>

      <!-- Column: Recent -->
      <div data-reveal class="flex-1 border-t lg:border-t-0 lg:border-l border-[#ccced3] p-7 flex flex-col">
        <h3 class="font-heading font-medium text-2xl text-dark tracking-[-0.6px]">
          Recent
        </h3>
        <p class="text-lg leading-relaxed text-dark mt-2">
          Latest reviews from December 2025 to February 2026.
        </p>
        <div class="flex items-end gap-2 mt-auto pt-6">
          <span class="font-heading font-medium leading-[1.1] text-dark tracking-[-1.4px]" style="font-size: clamp(2.5rem, 7vw, 3.5rem);">6</span>
          <span class="text-sm text-dark mb-3">reviews</span>
        </div>
        <div class="mt-4"><Btn href="/reviews" variant="primary" size="sm">See All</Btn></div>
      </div>
    </div>
  </div>
</section>
