---
/**
 * TiltDivider — angled SVG divider that overlays the TOP of the next section.
 *
 * Render this divider INSIDE the next section (or immediately before it as a
 * sibling that absolutely overlays its top edge). The triangle is drawn in the
 * previous section's color, sitting on top of the new section, so the diagonal
 * "eats into" the new section instead of adding stacked height.
 *
 * Usage:
 *   <TiltDivider from="white" direction="right" />
 *   <SectionWithNavyBg />
 *
 * The divider has zero intrinsic height — it's absolutely positioned. Wrap it
 * with the next section using a `relative` parent, OR place the divider at the
 * top of the next section's `<section>` element (which must be `relative`).
 *
 * Direction:
 *   "right" — diagonal falls down to the right (\)
 *   "left"  — diagonal falls down to the left  (/)
 */
interface Props {
  from?: string;
  direction?: 'left' | 'right';
  height?: number;
  position?: 'top' | 'bottom';
}
const {
  from = 'white',
  direction = 'right',
  height = 80,
  position = 'top',
} = Astro.props;

const colorMap: Record<string, string> = {
  white: '#ffffff',
  'light-gray': '#f3f4f6',
  navy: '#1a2d46',
  accent: '#e8ea3a',
  dark: '#0f1419',
};

const resolveColor = (c: string) => colorMap[c] ?? c;
const fromColor = resolveColor(from);

// Slight randomization +/- 4 units so each tilt feels hand-drawn (controls slope only)
const jitter = Math.floor(Math.random() * 9) - 4;

// Triangle in the "from" color sits at the top OR bottom of the section.
// position=top: from-color triangle eats into top of next section
// position=bottom: next-color triangle eats into bottom of current section
// Polygons always reach 0 and `height` exactly so there's no sub-pixel seam.
const slope = height + jitter;
const H = height;
const polygonPoints = position === 'top'
  ? (direction === 'right'
      ? `0,0 100,0 0,${slope}`
      : `0,0 100,0 100,${slope}`)
  : (direction === 'right'
      ? `0,${slope} 100,0 100,${H} 0,${H}`
      : `0,0 100,${slope} 100,${H} 0,${H}`);

const positionClass = position === 'top' ? 'top-0' : 'bottom-0';
---

<div
  class={`absolute ${positionClass} left-0 right-0 w-full overflow-hidden leading-[0] pointer-events-none z-20`}
  style={`height: ${height}px;`}
  aria-hidden="true"
>
  <svg
    class="block w-full h-full"
    viewBox={`0 0 100 ${height}`}
    preserveAspectRatio="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <polygon points={polygonPoints} fill={fromColor} />
  </svg>
</div>
