---
import Layout from "../layouts/Layout.astro";
import S01Navigation from "../components/sections/S01Navigation.astro";
import PageHero from "../components/credo/PageHero.astro";
import AboutHospitality from "../components/credo/AboutHospitality.astro";
import AboutWhy from "../components/credo/AboutWhy.astro";
import AboutStats from "../components/credo/AboutStats.astro";
import SingleQuote from "../components/credo/SingleQuote.astro";
import AboutPersonal from "../components/credo/AboutPersonal.astro";
import ContactCta from "../components/credo/ContactCta.astro";
import S10Footer from "../components/sections/S10Footer.astro";
import BtnText from "../components/credo/BtnText.astro";
import TiltDivider from "../components/credo/TiltDivider.astro";
import { href } from '../lib/nav';
---

<Layout title="About Andy, Credo Financial Services">
  <S01Navigation />
  <PageHero
    bgImage="about"
    eyebrow="About Andy"
    heading="There's a moment I keep coming back to."
    body={[
      "I was twenty-three, navigating a container ship through a typhoon off the coast of Japan. Between us and the rocks: a compass, a chart, and whether I'd done my job properly.",
      "The Merchant Navy teaches you something that stays with you. When it matters, people don't want a system. They want a person who knows what they're doing and picks up the phone.",
      "That's still how I work. Forty years later.",
    ]}
  />
  <!-- AboutHospitality (white) -->
  <div class="relative bg-white">
    <TiltDivider from="navy" direction="right" />
    <AboutHospitality />
  </div>
  <!-- AboutWhy (light-gray) -->
  <div class="relative">
    <TiltDivider from="white" direction="left" />
    <AboutWhy />
  </div>
  <!-- AboutStats (navy) -->
  <div class="relative">
    <TiltDivider from="light-gray" direction="right" />
    <AboutStats />
  </div>
  <!-- Proof narrative (white) -->
  <div class="relative bg-white">
    <TiltDivider from="navy" direction="left" />
    <section class="pt-32 pb-20 sm:pt-40 sm:pb-28 lg:pt-48 lg:pb-32">
      <div class="max-w-[1232px] mx-auto px-4 sm:px-6 lg:px-8">
        <p class="text-xs uppercase tracking-widest text-dark mb-4">Five years, one client, no slogans</p>
        <div class="w-12 h-0.5 bg-accent mb-12"></div>
        <div class="max-w-3xl">
          <p class="text-gray-text leading-relaxed mb-6">
            Sallyann Reed has been a client for five years. When there's a better deal available for her business, I tell her. When something goes wrong, she calls me and we sort it. That's how it should work.
          </p>
          <p class="text-gray-text leading-relaxed">
            That's what Credo FS is built on. Not a slogan, but a way of deciding whether to take on a piece of work in the first place.
          </p>
        </div>
      </div>
    </section>
  </div>
  <SingleQuote
    label="Proof"
    heading="Five years and counting"
    quote="He has always been committed to providing me with an excellent service, knowing how my business works. If there's a better package for me he'll come in and advise me to change."
    name="Sallyann Reed"
    source="Five years as a customer, TrustPilot"
    linkText="Read all reviews on TrustPilot"
    linkHref="/reviews"
  />
  <!-- AboutPersonal (light-gray) -->
  <div class="relative">
    <TiltDivider from="white" direction="right" />
    <AboutPersonal />
  </div>
  <!-- ContactCta (navy) -->
  <div class="relative">
    <TiltDivider from="light-gray" direction="left" />
    <ContactCta
      heading="Not sure if you're getting a fair deal?"
      subtext="Let's find out. I'll go through your setup, tell you straight, and if there's nothing to change, I'll say so."
      hint="A conversation costs nothing."
    />
  </div>
  <S10Footer />
</Layout>
