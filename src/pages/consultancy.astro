---
import Layout from "../layouts/Layout.astro";
import S01Navigation from "../components/sections/S01Navigation.astro";
import PageHero from "../components/credo/PageHero.astro";
import ConsultancyStats from "../components/credo/ConsultancyStats.astro";
import PartnersGrid from "../components/credo/PartnersGrid.astro";
import ConsultancyProcess from "../components/credo/ConsultancyProcess.astro";
import SingleQuote from "../components/credo/SingleQuote.astro";
import S22FaqAccordion from "../components/sections/S22FaqAccordion.astro";
import PatternBridge from "../components/credo/PatternBridge.astro";
import ContactCta from "../components/credo/ContactCta.astro";
import S10Footer from "../components/sections/S10Footer.astro";
import TiltDivider from "../components/credo/TiltDivider.astro";
---

<Layout title="Consultancy, Credo Financial Services">
  <S01Navigation />
  <PageHero
    bgImage="consultancy"
    eyebrow="Consultancy"
    heading="Your card machine provider isn't losing sleep over what they charge you."
    body={[
      "Last year I sat down with a restaurant owner in Bristol who was convinced she was on a fair deal. Her provider had told her so. I asked if I could look at her statements.",
      "She was paying 2.9% on every card transaction. On £15,000 a month in card sales, that's £435 a month in processing fees. I moved her to 1.1%. Her new monthly cost: £165. That's £270 back in her pocket every month. Over £3,200 a year.",
      "She'd been overpaying for three years. Nobody had told her.",
      "Why would they?",
    ]}
  />
  <!-- ConsultancyStats (white) -->
  <div class="relative bg-white">
    <TiltDivider from="navy" direction="right" />
    <ConsultancyStats />
  </div>
  <!-- PartnersGrid (white) — no tilt needed; same bg -->
  <PartnersGrid />
  <!-- ConsultancyProcess (light-gray) -->
  <div class="relative">
    <TiltDivider from="white" direction="left" />
    <ConsultancyProcess />
  </div>
  <!-- TestimonialBlock (white) -->
  <div class="relative">
    <TiltDivider from="light-gray" direction="right" />
    <SingleQuote
      label="Proof"
      heading="Five years and counting"
      quote="He has always been committed to providing me with an excellent service, knowing how my business works. If there's a better package for me he'll come in and advise me to change."
      name="Sallyann Reed"
      source="Five years as a customer, TrustPilot"
      linkText="Read all reviews on TrustPilot"
      linkHref="/reviews"
    />
  </div>
  <!-- FAQ (light-gray gradient) -->
  <div class="relative">
    <TiltDivider from="white" direction="left" />
    <S22FaqAccordion />
  </div>
  <!-- PatternBridge (accent) -->
  <div class="relative">
    <TiltDivider from="white" direction="right" />
    <PatternBridge
      heading="Pubs, restaurants, cafes, bars, and sports clubs. Single sites and small groups across the South West and London."
      linkText="Arrange a call with Andy"
      linkHref="#"
    />
  </div>
  <!-- ContactCta (navy) -->
  <div class="relative">
    <TiltDivider from="accent" direction="left" />
    <ContactCta
      heading="Find out if you're overpaying. It takes fifteen minutes."
      subtext="I'll look at your statements, check your setup, and give you an honest answer. If there's something better out there, I'll find it. If not, we shake hands and you've lost nothing."
      hint="No cost and no contract."
    />
  </div>
  <S10Footer />
</Layout>
